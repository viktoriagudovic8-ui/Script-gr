-- Fly + Noclip + обход анти-флая. Вверх/вниз — камера + джойстик вперёд.

local button = script.Parent
local player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")

local speed = 50
local flying = false
local conn, bv, bg = nil, nil, nil

-- ===== NOCLIP =====
local function setNoclip(state)
    local char = player.Character
    if not char then return end
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = state
        end
    end
    -- чтобы при включении снова можно было ходить по земле
    if state then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then hrp.CanCollide = true end
    end
end

-- ===== СТОП =====
local function stopFly()
    flying = false
    if conn then conn:Disconnect() conn = nil end

    local char = player.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hrp then
            local b = hrp:FindFirstChild("VelocityHandler"); if b then b:Destroy() end
            local g = hrp:FindFirstChild("GyroHandler");     if g then g:Destroy() end
        end
        if hum then hum.PlatformStand = false end
        setNoclip(true)   -- вернуть коллизии
    end
    bv, bg = nil, nil
end

-- ===== СТАРТ =====
local function startFly()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    flying = true

    -- обход анти-флая: держим ownership на себе
    pcall(function() hrp:SetNetworkOwner(player) end)

    bv = Instance.new("BodyVelocity")
    bv.Name = "VelocityHandler"
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    bg = Instance.new("BodyGyro")
    bg.Name = "GyroHandler"
    bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bg.P = 10000
    bg.D = 500
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp

    hum.PlatformStand = true
    setNoclip(false)   -- включить noclip

    conn = RunService.RenderStepped:Connect(function()
        if not flying then return end
        local char = player.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or not bv or not bg then return end

        -- обход анти-флая каждый кадр
        pcall(function() hrp:SetNetworkOwner(player) end)
        hum.PlatformStand = true

        -- noclip каждый кадр (античит может вернуть CanCollide)
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                part.CanCollide = false
            end
        end

        -- движение по камере (вверх/вниз = наклон камеры + джойстик вперёд)
        local cam = workspace.CurrentCamera
        local lookFull = cam.CFrame.LookVector
        local lookHoriz = Vector3.new(lookFull.X, 0, lookFull.Z)
        if lookHoriz.Magnitude < 0.01 then lookHoriz = Vector3.new(0, 0, -1) end
        lookHoriz = lookHoriz.Unit
        local rightHoriz = Vector3.new(-lookHoriz.Z, 0, lookHoriz.X)

        local md = hum.MoveDirection
        local fwdInput   = md:Dot(lookHoriz)
        local rightInput = md:Dot(rightHoriz)

        bv.Velocity = lookFull * (fwdInput * speed) + rightHoriz * (rightInput * speed)
        bg.CFrame = cam.CFrame
    end)
end

